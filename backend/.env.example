# Clave gratuita de NASA FIRMS, necesaria para la alerta de humo por quemas
# (backend/src/lib/humo.js). Se consigue en 1 minuto, sin costo, registrando
# un email en: https://firms.modaps.eosdis.nasa.gov/api/map_key/
#
# Sin esta variable la app sigue funcionando igual (el resto de las
# funcionalidades no dependen de esto): /api/humo simplemente responde
# con estado "datos_no_disponibles".
FIRMS_MAP_KEY=

# Bot de Telegram para recibir alertas por suscripción (backend/src/lib/bot.js).
# Se crea gratis hablando con @BotFather en Telegram: mandale "/newbot",
# seguí los pasos, y te va a dar un token con forma "123456:ABC-DEF...".
# TELEGRAM_BOT_USERNAME es el nombre de usuario del bot que elegiste al
# crearlo (sin el @), se usa solo para armar el link "Recibí alertas en
# Telegram" en la web.
#
# Sin TELEGRAM_BOT_TOKEN, el bot simplemente no arranca (no rompe nada mas).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
